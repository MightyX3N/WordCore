<article class="page wrap">
  <% if layout == "home" then %>
  <header class="hero">
    <h1><%= site.name %></h1>
    <% if site.tagline ~= "" then %><p class="lead"><%= site.tagline %></p><% end %>
  </header>
  <% else %>
  <header class="page-header">
    <h1><%= page.title %></h1>
  </header>
  <% end %>
  <div class="prose">
    <%- page.html %>
  </div>
</article>
