<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title><%= title %> · <%= site_name %> · WordCore</title>
<link rel="stylesheet" href="<%= asset('admin.css') %>">
<script src="<%= asset('admin.js') %>" defer></script>
</head>
<body>
<div class="shell">
  <nav class="rail" aria-label="Admin">
    <a class="brand" href="<%= url('/admin') %>">
      <span class="logo" aria-hidden="true">W</span>
      <span class="brand-text"><span class="brand-name"><%= site_name %></span><span class="brand-link">WordCore admin</span></span>
    </a>
    <div class="rail-nav">
    <% local last_section = nil %>
    <% for _, item in ipairs(nav) do %>
      <% if item.section and item.section ~= last_section then last_section = item.section %>
      <p class="nav-sec"><%= item.section %></p>
      <% end %>
      <a class="nav" href="<%= url(item.path) %>"<% if item.id == active then %> aria-current="page"<% end %>><%- item.icon %><span><%= item.label %></span></a>
    <% end %>
      <a class="nav" href="<%= url('/') %>"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M9 2.5h4.5V7M13.5 2.5L7 9M11.5 9.5v4h-9v-9h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg><span>View site</span></a>
    </div>
    <div class="rail-user">
      <span class="avatar" aria-hidden="true"><%= (user.display_name ~= '' and user.display_name or user.username):sub(1, 1):upper() %></span>
      <span class="rail-user-text"><a href="<%= url('/admin/account') %>"<% if active == 'account' then %> aria-current="page"<% end %>><%= user.display_name ~= '' and user.display_name or user.username %></a><span><%= role_label %></span></span>
      <form method="post" action="<%= url('/admin/logout') %>"><%- csrf_field() %><button type="submit" class="rail-logout">Log out</button></form>
    </div>
  </nav>
  <main class="work" id="main">
    <div class="container<% if narrow then %> narrow<% end %>">
      <%- flash_html %>
      <header class="page-head">
        <div>
          <h1><%= title %></h1>
          <% if subtitle then %><p><%= subtitle %></p><% end %>
        </div>
        <% if actions_html then %><div class="actions"><%- actions_html %></div><% end %>
      </header>
      <%- body %>
      <p class="footer">WordCore <%= version %> · <a href="<%= url('/_wc/notices') %>">Licences</a></p>
    </div>
  </main>
</div>
</body>
</html>
